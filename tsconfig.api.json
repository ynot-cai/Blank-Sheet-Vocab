{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 只放 Node 类型：api/ 跑在 Vercel 的 Node 运行时里，不该看到 DOM 的 window / document。
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    "noEmit": true,
    // ⚠️ 这一行不是可选项，删掉会立刻炸出一堆 TS5097。
    //
    // api/**/*.ts 的相对导入**必须**带 .ts 后缀，原因有两个：
    // 1. 本项目的测试脚本（api/_dev/*.mjs）是**直接用 node 跑 TypeScript 源码**的，
    //    Node 的 ESM 解析器要求显式扩展名——去掉后缀会 ERR_MODULE_NOT_FOUND；
    // 2. Vercel 用 esbuild 打包 api/，带 .ts 后缀能正常解析。
    // 所以「去掉后缀」这个看起来很自然的做法在本项目里是行不通的（实测已验证）。
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["api"]
}
