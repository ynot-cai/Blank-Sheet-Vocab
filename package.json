{
  "name": "blank-sheet-vocab",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "白纸单词 —— 白纸空间记忆背单词应用（本地优先 + 可选云同步）",
  "scripts": {
    "dev": "vite",
    "api": "node api/_dev/server.mjs",
    "preflight": "node scripts/preflight.mjs",
    "rules:check": "node scripts/checkRules.mjs",
    "emit:api": "node scripts/emit-api.mjs",
    "verify:api": "node scripts/emit-api.mjs && node scripts/verify-api-emit.mjs",
    "typecheck": "tsc -b",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "build": "npm run preflight && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:api": "node api/_dev/test-api.mjs",
    "test:sync": "node api/_dev/test-sync.mjs",
    "test:kc": "node api/_dev/test-kc.mjs",
    "test:kc-ui": "node api/_dev/test-kc-ui.mjs",
    "test:kc-import": "node api/_dev/test-kc-import.mjs",
    "test:kc-import-ui": "node api/_dev/test-kc-import-ui.mjs",
    "test:kc-edit": "node api/_dev/test-kc-edit.mjs",
    "test:kc-edit-ui": "node api/_dev/test-kc-edit-ui.mjs",
    "test:kc-session": "node api/_dev/test-kc-session.mjs",
    "test:kc-session-ui": "node api/_dev/test-kc-session-ui.mjs",
    "test:kc-exam": "node api/_dev/test-kc-exam.mjs",
    "test:kc-exam-ui": "node api/_dev/test-kc-exam-ui.mjs",
    "test:kc-review": "node api/_dev/test-kc-review.mjs",
    "test:kc-review-ui": "node api/_dev/test-kc-review-ui.mjs",
    "test:kc-settings": "node api/_dev/test-kc-settings.mjs",
    "test:kc-e2e": "node api/_dev/test-kc-e2e.mjs",
    "test:ai": "node api/_dev/test-aiproxy.mjs",
    "test:mobile": "node api/_dev/test-mobile.mjs",
    "test:pwa": "node api/_dev/test-pwa.mjs",
    "test:about": "node api/_dev/test-about.mjs",
    "test:build": "node api/_dev/test-build.mjs",
    "test:presets": "node api/_dev/test-presets.mjs && node scripts/build-presets.mjs --check",
    "test:presets-ui": "node api/_dev/test-presets-ui.mjs",
    "test:r1": "node api/_dev/test-r1.mjs",
    "test:r2": "node api/_dev/test-r2.mjs",
    "test:r3": "node api/_dev/test-r3.mjs",
    "test:r4": "node --import ./api/_dev/loader-register.mjs api/_dev/test-r4.mjs",
    "test:r4-ui": "node api/_dev/test-r4-ui.mjs",
    "test:paper": "node --import ./api/_dev/loader-register.mjs api/_dev/test-paper.mjs",
    "test:paper-ui": "node api/_dev/test-paper-ui.mjs",
    "test:rename": "node api/_dev/test-rename.mjs",
    "test:sense-rules": "node --import ./api/_dev/loader-register.mjs api/_dev/test-sense-rules.mjs",
    "presets": "node scripts/build-presets.mjs",
    "test:live": "node scripts/run-live.mjs",
    "test:live-ui": "node api/_dev/test-live-ui.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "npm run rules:check && npm run typecheck && npm run build && npm run verify:api && npm run test:build && npm run test:rename && npm run test:sense-rules && npm run test:presets && npm run test:api && npm run test:sync && npm run test:r1 && npm run test:r2 && npm run test:r3 && npm run test:r4 && npm run test:paper && npm run test:kc && npm run test:kc-import && npm run test:kc-edit && npm run test:kc-session && npm run test:kc-exam && npm run test:kc-review && npm run test:kc-settings && npm run test:ai && npm run test:mobile && npm run test:pwa && npm run test:about"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
